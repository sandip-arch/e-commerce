<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form id="userRegistrationForm" action="/register" method="POST">
  <!-- Username -->
  <div>
    <label for="userName">Username *</label>
    <input 
      id="userName" 
      name="userName" 
      required 
      autocomplete="username" 
      placeholder="e.g. johndoe" 
    />
  </div>

  <!-- Email -->
  <div>
    <label for="email">Email *</label>
    <input 
      type="email" 
      id="email" 
      name="email" 
      required 
      autocomplete="email" 
      placeholder="name@example.com" 
    />
  </div>

  <!-- Phone (Optional) -->
  <div>
    <label for="phone">Phone Number</label>
    <input 
      type="tel" 
      id="phone" 
      name="phone" 
      pattern="[0-9]*" 
      inputmode="numeric" 
      placeholder="10-digit mobile number" 
    />
  </div>

  <!-- Password -->
  <div>
    <label for="password">Password *</label>
    <input 
      type="password" 
      id="password" 
      name="password" 
      required 
      autocomplete="new-password" 
    />
  </div>

  <!-- Gender (Enum: male, female, other) -->
  <div>
    <label for="gender">Gender *</label>
    <select id="gender" name="gender" required>
      <option value="" disabled selected>Select gender</option>
      <option value="male">Male</option>
      <option value="female">Female</option>
      <option value="other">Other</option>
    </select>
  </div>

  <!-- Address -->
  <div>
    <label for="address">Address *</label>
    <textarea 
      id="address" 
      name="address" 
      rows="3" 
      required 
      placeholder="Street, apartment, city, zip code"
    ></textarea>
  </div>
  <!-- Pin Code -->
  <div>
    <label for="pinCode">Pin Code *</label>
    <input 
      type="number" 
      id="pinCode" 
      name="pinCode" 
      required 
      placeholder="10-digit pin code" 
    />
  </div>
  <!-- Nearest Landmark -->
  <div>
    <label for="nearestLandmark">Nearest Landmark *</label>
    <input 
      type="text" 
      id="nearestLandmark" 
      name="nearestLandmark" 
      required 
      placeholder="Near Metro Station, opposite park, etc." 
    />
  </div>

  <button type="submit">Create Account</button>
</form>
</body>
</html>