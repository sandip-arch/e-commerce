<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Sign in</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      background: #f8f8f8;
      font-family: Arial, Helvetica, sans-serif;
      color: #111827;

      display: flex;
      justify-content: center;
      align-items: center;
    }

    .page {
      width: 100%;
      max-width: 420px;
      padding: 20px;
    }

    .login-card {
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      padding: 34px;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
    }

    .logo {
      text-align: center;
      margin-bottom: 25px;
    }

    .logo-mark {
      width: 48px;
      height: 38px;
      margin: auto;
      background: #4f5bea;
      border-radius: 8px 8px 14px 14px;
      position: relative;
    }

    .logo-mark::before {
      content: "";
      position: absolute;
      width: 34px;
      height: 7px;
      background: #4f5bea;
      top: -6px;
      left: 7px;
      border-radius: 4px;
    }

    h1 {
      text-align: center;
      font-size: 25px;
      font-weight: 500;
      margin: 0 0 25px;
    }

    .description {
      text-align: center;
      font-size: 14px;
      line-height: 1.5;
      color: #374151;
      margin-bottom: 22px;
    }

    .field {
      margin-bottom: 18px;
    }

    label {
      display: block;
      font-size: 14px;
      font-weight: 500;
      margin-bottom: 7px;
    }

    input {
      width: 100%;
      height: 46px;
      padding: 0 13px;
      border: 1px solid #9ca3af;
      border-radius: 4px;
      font-size: 15px;
      outline: none;
    }

    input:focus {
      border-color: #4f5bea;
      box-shadow: 0 0 0 1px #4f5bea;
    }

    .login-button {
      width: 100%;
      height: 46px;
      border: 0;
      border-radius: 4px;
      background: #4f5bea;
      color: white;
      font-size: 15px;
      cursor: pointer;
    }

    .login-button:hover {
      background: #414bd1;
    }

    .divider {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 25px 0;
      color: #6b7280;
      font-size: 13px;
    }

    .divider::before,
    .divider::after {
      content: "";
      height: 1px;
      background: #d1d5db;
      flex: 1;
    }

    .social-button {
      width: 100%;
      height: 46px;
      margin-bottom: 9px;
      background: white;
      border: 1px solid #cfd2d6;
      border-radius: 4px;
      font-size: 14px;
      cursor: pointer;
    }

    .social-button:hover {
      background: #f5f5f5;
    }

    .signup {
      margin-top: 20px;
      padding: 18px;
      background: white;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      text-align: center;
      font-size: 14px;
    }

    .signup a {
      color: #4f5bea;
      font-weight: 600;
      text-decoration: none;
    }

    .footer {
      text-align: center;
      margin-top: 90px;
      font-size: 13px;
    }

    .footer a {
      color: #4f5bea;
      margin: 0 8px;
    }
  </style>
</head>

<body>

  <main class="page">

    <section class="login-card">

      <div class="logo">
        <div class="logo-mark"></div>
      </div>

      <h1>Sign in</h1>

      <p class="description">
        Sign in to continue to <strong>My App</strong>.
      </p>

      <form id="userRegistrationForm" method="post" action="/login">

        <div class="field">
          <label for="email">
            Username or email address *
          </label>

          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="name@example.com"
          >
        </div>

        <div class="field">
          <label for="password">
            Password *
          </label>

          <input
            type="password"
            id="password"
            name="password"
            required
            autocomplete="current-password"
          >
        </div>

        <button class="login-button" type="submit">
          Continue
        </button>

      </form>

      <div class="divider">
        OR
      </div>

      <button class="social-button" type="button">
        Continue with Google
      </button>

     

    </section>

    <div class="signup">
      Don't have an account?
      <a href="#">Sign Up</a>
    </div>

    <footer class="footer">
      <a href="#">Privacy Policy</a>
      ·
      <a href="#">Terms of Service</a>
    </footer>

  </main>

  <script>
    document
      .getElementById("userRegistrationForm")
      .addEventListener("submit", function (event) {

        event.preventDefault();

        // Demo only: do not send or store passwords.
        alert("Demo login form — no credentials were submitted.");

      });
  </script>

</body>
</html>
