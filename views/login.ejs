<body>

    <form id="userRegistrationForm" action="/login" method="POST">
 

  <!-- Email -->
  <div>
    <label for="email">Email *</label>
    <input 
      type="email" 
      id="email" 
      name="email" 
      required 
      autocomplete="email" 
      placeholder="name@example.com" 
    />
  </div>

  


  <!-- Password -->
  <div>
    <label for="password">Password *</label>
    <input 
      type="password" 
      id="password" 
      name="password" 
      required 
      autocomplete="new-password" 
    />
  </div>

